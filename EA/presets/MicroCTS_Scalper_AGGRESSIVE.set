; MicroCTS Scalper - AGGRESSIVE preset (bounded Javier-style scale-in)
; Keeps the "stack winners" behaviour the user liked, but hard-capped:
; max 3 concurrent positions, no martingale lots, aggregate risk cap,
; basket stop at -3% equity, margin gates before every send.
; ONLY after the SAFE preset has been validated in Tester + demo.
InpMagic=20261008
InpComment=MCTSa
InpRiskPercent=0.75
InpMaxTotalRiskPercent=2.25
InpMaxConcurrentPositions=3
InpMaxLotCap=0.10
InpNoAddWhileLosing=false
InpDailyLossLimitPercent=4.0
InpMaxTradesPerDay=15
InpBasketStopEquityPercent=3.0
InpMarginBufferFactor=5.0
InpMinMarginLevelAfterEntryPct=1500
InpEntryMode=1
InpSpikeLookbackBars=80
InpSpikeMinCandles=2
InpSpikeMinBodyATR=0.7
InpSpikeMinTotalATR=1.8
InpSpikeCloseExtremeFrac=0.3
InpChannelMinCandles=3
InpChannelMaxCandles=25
InpChannelMaxBodyATR=0.55
InpChannelTolerancePoints=3
InpChannelMaxRetraceFrac=0.618
InpUseInsideBarEntry=true
InpMaxAttemptsPerSetup=3
InpEntryBufferPoints=5
InpSlBufferPoints=5
InpPendingExpiryBars=6
InpMaxSlATR=3.0
InpHTF=15
InpUseTrendFilter=true
InpEmaFastHTF=50
InpEmaSlowHTF=200
InpUseSwingStructure=true
InpSwingStrength=2
InpUsePrzFilter=true
InpMinPrzScore=1
InpPrzProximityATR=0.6
InpPrzFibLookbackHTF=120
InpPrzSwingLookbackHTF=60
InpRoundNumberStep=5.0
InpUsePivots=true
InpMomentumMode=1
InpTimeDivMinRatio=1.15
InpRsiPeriodHTF=14
InpTpMode=0
InpTpRiskMultiple=2.0
InpTpStructBufferPoints=10
InpBreakevenAtR=0.7
InpTrailMode=1
InpTrailAtrMult=1.2
InpTrailActivateAtR=0.4
InpTrailDistancePoints=60
InpTrailLockPoints=20
InpPartialCloseEnabled=false
InpPartialCloseAtR=1.0
InpPartialCloseFraction=0.5
InpMaxSpreadPoints=45
InpUseSessionFilter=true
InpSessionStartHour=7
InpSessionEndHour=20
InpAtrPeriod=14
InpSlippagePoints=20
InpCooldownAfterRejectSec=300
InpShowChartComment=true
